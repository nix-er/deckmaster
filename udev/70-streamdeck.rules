KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="00e4", TAG+="uaccess"

# Keyboard emulation: deckmaster needs write access to /dev/uinput. Uncomment
# this rule, or add your user to the group that owns /dev/uinput.
# KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", GROUP="input", MODE="0660", TAG+="uaccess"
